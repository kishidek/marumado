# Dependencies
node_modules

# Build output: the extension is built into .output/ (npm run build / npm run zip).
# Prebuilt zips are published as GitHub Releases, not committed.
.output
.wxt
*.zip
*.crx
stats.html
stats-*.json
web-ext.config.ts

# Extension signing keys: never commit
*.pem

# Test and render artifacts
dist
coverage
test-results
playwright-report
deck-videos/

# Scratch files
*.tmp*
logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.*

# Editor and OS
.vscode/
.idea
.DS_Store
*.sw?

# A global "Icon" ignore rule (macOS Icon\r files) would also match this folder on case-insensitive disks.
!/public/icon/
