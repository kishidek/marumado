{
  "name": "marumado",
  "description": "A desk plant for your new tab: an ajisai on a Kyoto windowsill that grows with your healthy work habits.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lab": "vite --config lab/vite.config.ts",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:tz": "TZ=Europe/Madrid vitest run && TZ=America/Santiago vitest run && TZ=Asia/Tokyo vitest run",
    "test:e2e": "wxt build && playwright test",
    "render:explainer": "node scripts/render-explainer.mjs",
    "render:deck": "wxt build --mode development && node scripts/render-deck.mjs"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "^5.3.0",
    "lucide": "^1.50.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
